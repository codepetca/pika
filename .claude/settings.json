{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(printenv*)",
      "Bash(env)"
    ],
    "allow": [
      "Bash(pnpm eval:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm check:*)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec vitest run*)",
      "Bash(pnpm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(node scripts/features.mjs*)",
      "Glob",
      "Grep"
    ]
  }
}
