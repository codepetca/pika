{
  "name": "pika-classroom-launch-alerts",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PIKA_LAUNCH_ALERTS_ENABLED": "false" },
  "send_email": [{ "name": "ALERT_EMAIL" }],
  "durable_objects": {
    "bindings": [{ "name": "DELIVERY", "class_name": "ClassroomLaunchAlertDelivery" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClassroomLaunchAlertDelivery"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
