# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Session (generate with: npm run generate:secret)
# Should be 64 hex characters (0-9, a-f only)
SESSION_SECRET=generate-a-secure-random-secret-with-npm-run-generate-secret

# Auth Configuration
# Comma-separated list of teacher emails for development
DEV_TEACHER_EMAILS=teacher@example.com,admin@yrdsb.ca

# WorkOS Magic Auth pilot (server-only, disabled by default)
# Keeps Pika's /login and /signup UI while WorkOS creates and verifies a
# six-digit email passcode. Do not enable until the dedicated Pika WorkOS
# application and all three secrets below are configured for the environment.
WORKOS_MAGIC_AUTH_PILOT=false
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# At least 32 characters; distinct per environment.
WORKOS_COOKIE_PASSWORD=
# Different ports on localhost still share host cookies, so Pika and Bara need
# distinct names even though their WorkOS sessions remain application-specific.
WORKOS_COOKIE_NAME=pika-wos-session
# Match Pika's remembered-login policy (180 days). WorkOS Dashboard maximum
# maximum session lifetime must be exactly 180 days; inactivity must not expire
# the credential earlier. This prevents both premature expiry and rolling login.
WORKOS_COOKIE_MAX_AGE=15552000
# Required only when hosted AuthKit/SSO is added; Magic Auth itself stays on /login.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
# Default: WorkOS sends the code. Use "brevo" only after WorkOS's default
# Magic Auth emails are disabled for this environment to prevent duplicates.
WORKOS_MAGIC_AUTH_EMAIL_DELIVERY=workos
# This is a deployment acknowledgement, not a dashboard-control API. Brevo
# delivery fails closed unless both values are set exactly as shown.
WORKOS_MAGIC_AUTH_DEFAULT_EMAILS_DISABLED=false

# Retired cross-application browser handoff. Native attendance stays in Pika
# and calls Bara only from Pika's server. Keep this disabled.
PIKA_BARA_AUTH_HANDOFF=false

# Pika -> Bara attendance API (server-only, disabled by default). The base URL
# is the replaceable Bara adapter origin; Pika never calls Convex functions or
# receives Convex IDs. The ref and secret must match the target Bara environment.
PIKA_BARA_ATTENDANCE_ENABLED=false
# Exact Pika UUID pair for the initial server-enforced production canary.
PIKA_BARA_ATTENDANCE_CANARY_TEACHER_ID=
PIKA_BARA_ATTENDANCE_CANARY_CLASSROOM_ID=
# Runtime admission defaults to exact_canary when unset. Keep the exact pair
# configured in teacher_entitlements mode because deployed smoke remains bound to it.
PIKA_BARA_ATTENDANCE_SCOPE_MODE=exact_canary
BARA_ATTENDANCE_API_BASE_URL=
BARA_ATTENDANCE_INSTALLATION_REF=
BARA_ATTENDANCE_TENANT_REF=
BARA_ATTENDANCE_INTEGRATION_SECRET=
# Encrypts the public Pika QR-entry envelope; distinct from all transport,
# event, session, WorkOS-cookie, and cron secrets.
BARA_ATTENDANCE_ENTRY_TOKEN_SECRET=
# Separate reverse-direction secret used only for Bara -> Pika lifecycle events.
BARA_ATTENDANCE_EVENT_SECRET=

# Email Configuration
# For development: set ENABLE_MOCK_EMAIL=true to log codes to console
# For production/staging: set ENABLE_MOCK_EMAIL=false and configure Brevo
ENABLE_MOCK_EMAIL=true

# Brevo (Sendinblue) - for production email sending
# Get API key from: https://app.brevo.com/settings/keys/api
# Template ID from: https://app.brevo.com/camp/lists/template
BREVO_API_KEY=
BREVO_TEMPLATE_ID=2
BREVO_FROM_EMAIL=noreply@notify.codepet.ca
BREVO_FROM_NAME=Pika

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UI Gallery (dev/staging)
ENABLE_UI_GALLERY=false

# Cron (Vercel Cron Jobs)
# Vercel will send this value as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-a-secure-random-secret
# Manual attendance smoke only; keep distinct from CRON_SECRET and all HMAC secrets.
BARA_ATTENDANCE_SMOKE_OPERATOR_SECRET=generate-a-distinct-secure-random-secret

# AI (optional)
# Used for AI grading, log summaries, and developer feedback extraction
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=
OPENAI_DEVELOPER_FEEDBACK_MODEL=

# Gradex smoke integration (optional)
# Used by `pnpm smoke:gradex` to submit sanitized sample assignment data to Gradex.
GRADEX_API_URL=http://localhost:3000
GRADEX_API_KEY=
GRADEX_INTERNAL_TOKEN=
GRADEX_SMOKE_POLL_ATTEMPTS=20
GRADEX_SMOKE_POLL_INTERVAL_MS=1500

# Gradex assignment grading integration (optional, disabled by default)
# When true, assignment background auto-grade runs submit sanitized data to Gradex
# instead of grading each item directly inside Pika.
GRADEX_ASSIGNMENT_GRADING_ENABLED=false
CLASSROOM_ARCHIVE_EXPORT_ENABLED=false
CLASSROOM_ARCHIVE_EXPORT_TEACHER_IDS=
CLASSROOM_ARCHIVE_RESTORE_ENABLED=false
CLASSROOM_ARCHIVE_RESTORE_TEACHER_IDS=
# Set to the plan/project database quota. Free plan default is 500 MiB (524288000 bytes).
CLASSROOM_ARCHIVE_RESTORE_DATABASE_BUDGET_BYTES=
# Server-only destructive canary. All three settings must match before migration 085 can be invoked.
CLASSROOM_ARCHIVE_COMPACTION_ENABLED=false
CLASSROOM_ARCHIVE_COMPACTION_TEACHER_IDS=
CLASSROOM_ARCHIVE_COMPACTION_ARCHIVE_IDS=
# Server-only source-object worker. Keep disabled until migration 096 is applied and recovery passes.
CLASSROOM_ARCHIVE_SOURCE_CLEANUP_ENABLED=false
# Manual CRON_SECRET-authenticated canary route. It is not scheduled in vercel.json.
CLASSROOM_ARCHIVE_SOURCE_CLEANUP_TRIGGER_ENABLED=false
CLASSROOM_ARCHIVE_SOURCE_CLEANUP_OPERATION_ID=
CLASSROOM_ARCHIVE_STAGING_CLEANUP_ENABLED=false
# Reclaims Storage objects left by terminally failed archive export/restore operations.
CLASSROOM_ARCHIVE_OBJECT_CLEANUP_ENABLED=false
# Server-only classroom Gradex extract canary. Keep disabled until migration 084 is applied.
CLASSROOM_GRADEX_EXTRACT_ENABLED=false
CLASSROOM_GRADEX_EXTRACT_TEACHER_IDS=
# At least 32 bytes. Rotation intentionally invalidates in-progress idempotency keys.
CLASSROOM_GRADEX_EXTRACT_HMAC_SECRET=
# Separate teacher-route canary. Both this flag and the exact source archive UUID are required.
CLASSROOM_GRADEX_TRIGGER_ENABLED=false
CLASSROOM_GRADEX_TRIGGER_ARCHIVE_IDS=
# Server-only retention worker. Keep disabled until migration 084 is applied.
CLASSROOM_GRADEX_CLEANUP_ENABLED=false
# Manual CRON_SECRET-authenticated canary route. It is not scheduled in vercel.json.
CLASSROOM_GRADEX_CLEANUP_TRIGGER_ENABLED=false
CLASSROOM_GRADEX_CLEANUP_OPERATION_ID=
GRADEX_PIKA_PSEUDONYM_SALT=

# Pal achievements pilot (server-only, disabled by default)
# PAL_ENABLED is the pilot's only feature flag. The other values are connection
# settings and are ignored while the flag is disabled.
PAL_ENABLED=false
# HTTPS origin only (no path/query/credentials). Loopback HTTP is development-only.
PAL_API_URL=
# Distinct high-entropy secret, at least 32 characters.
PAL_INTEGRATION_SECRET=
# Stable HMAC secret used only to make opaque Pal learner/classroom/item tokens.
# Keep stable and distinct from the integration secret; minimum 32 characters.
# Rotating it changes every Pal identity and fact key.
PAL_PSEUDONYM_SECRET=

# GitHub API (optional for repo review helpers)
# Token needs `repo` scope, or `public_repo` if the repo is public.
GITHUB_PAT=
GITHUB_FEEDBACK_TOKEN=

# Dangerous operations (scripts)
# Required to run `npm run seed:fresh` (it wipes data).
ALLOW_DB_WIPE=false

# Dev endpoints (development only)
# Required to enable /api/dev/* endpoints like reseed
ALLOW_DEV_ENDPOINTS=true
